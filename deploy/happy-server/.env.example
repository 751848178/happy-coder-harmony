# Upstream source to build from.
HAPPY_UPSTREAM_REPO=https://github.com/slopus/happy.git
HAPPY_UPSTREAM_REF=d343330c86ab966969aecd82be4aecbad7ec4238
# Optional source archive override. Keep empty to derive the GitHub archive URL from
# HAPPY_UPSTREAM_REPO and HAPPY_UPSTREAM_REF automatically.
HAPPY_UPSTREAM_ARCHIVE_URL=

# Public access address for clients and local file URLs.
HAPPY_PUBLIC_URL=https://happy.example.com
HAPPY_SERVER_PORT=3005

# Required secrets.
HANDY_MASTER_SECRET=replace-with-a-long-random-secret

# Existing PostgreSQL database.
# If PostgreSQL runs on the same host as Docker, you can use host.docker.internal.
# Shared database users should prefer a dedicated schema, for example ?schema=happy.
DATABASE_URL=postgresql://happy:change-me@postgres.example.com:5432/happy?schema=happy

# Local file storage inside the container. Keep the defaults unless you know you need to change them.
DATA_DIR=/data
# Leave empty when using external PostgreSQL.
# Only set this when you intentionally want the embedded PGlite fallback.
PGLITE_DIR=

# Optional. Leave blank for the upstream-recommended single-node mode.
REDIS_URL=

# Optional monitoring.
METRICS_ENABLED=false
METRICS_PORT=9090

# Optional S3-compatible object storage. Leave blank to keep local file storage in /data/files.
S3_HOST=
S3_PORT=
S3_USE_SSL=true
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Optional GitHub integration. If enabled, keep REDIRECT_URI and REDIRECT_URL the same value.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_REDIRECT_URL=
GITHUB_WEBHOOK_SECRET=
